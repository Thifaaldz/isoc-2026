[client]
port=3306
default-character-set = utf8mb4

[mysqld]
port=3306
character-set-server = utf8mb4
skip-character-set-client-handshake
skip-name-resolve
# Zona waktu default server: UTC+7 (WIB) untuk NOW(), CURRENT_TIMESTAMP, dll.
default-time-zone = '+07:00'
lower_case_table_names = 1
default-storage-engine = InnoDB
innodb_file_format = Barracuda
innodb_file_per_table = 1
innodb_log_file_size = 512M
innodb_strict_mode = 0

log_error = /var/log/mysql/error.log
general_log_file = /var/log/mysql/general.log
general_log = 0
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow-query.log
long_query_time = 1
log_queries_not_using_indexes = 0
# network
connect_timeout = 61
wait_timeout = 86400
max_connections = 500
max_allowed_packet = 256M
max_connect_errors = 100
# limits
# 1 GB per koneksi terlalu besar untuk ratusan koneksi; 64 MB cukup untuk query aplikasi.
tmp_table_size = 64M
max_heap_table_size = 64M
table_open_cache = 2000

# InnoDB: simpan data & index yang sering dibaca di memori (default hanya 128 MB).
# Produksi: ±50-70% RAM yang dialokasikan untuk database.
innodb_buffer_pool_size = 512M
# Tulis log transaksi ke disk tiap detik (bukan tiap commit): jauh lebih cepat, risiko kehilangan maks. 1 detik bila server mati mendadak.
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
thread_cache_size = 64